{% comment %}
  Block settings here are per-theme-placement overrides layered on top of the
  merchant's admin-configured WidgetSettings (fetched at runtime from
  data-settings-endpoint) — see mergeSettings() in ai-chat-widget.js. Only
  values the merchant actually changed away from the schema default here are
  applied as overrides; everything else falls back to the admin config.

  App embed blocks cap non-interactive settings at 6, so this schema keeps
  only the highest-value controls (color, position, header title, greeting,
  border radius) plus the two resource pickers (icon, featured collection),
  which are a separate "interactive" category.
{% endcomment %}
<div
  id="ai-chat-widget-root"
  data-chat-endpoint="{{ shop.url }}/apps/chat-widget/chat"
  data-settings-endpoint="{{ shop.url }}/apps/chat-widget/settings"
  data-messages-endpoint="{{ shop.url }}/apps/chat-widget/messages"
  data-history-endpoint="{{ shop.url }}/apps/chat-widget/history"
  data-block-settings='{
    "primaryColor": {{ block.settings.primary_color | json }},
    "iconUrl": {% if block.settings.icon %}{{ block.settings.icon | image_url: width: 128 | json }}{% else %}null{% endif %},
    "horizontalPosition": {{ block.settings.horizontal_position | json }},
    "verticalPosition": {{ block.settings.vertical_position | json }},
    "headerTitle": {{ block.settings.header_title | json }},
    "greetingMessage": {{ block.settings.greeting_message | json }},
    "featuredProductsCollectionHandle": {% if block.settings.featured_products_collection %}{{ block.settings.featured_products_collection.handle | json }}{% else %}null{% endif %},
    "borderRadius": {{ block.settings.border_radius | json }}
  }'
></div>

{{ 'ai-chat-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ai-chat-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AI Chat Widget",
  "target": "body",
  "settings": [
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "primary_color", "label": "Brand color" },
    { "type": "image_picker", "id": "icon", "label": "Activator icon" },
    { "type": "header", "content": "Position" },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical position",
      "options": [
        { "value": "lowest", "label": "Lowest" },
        { "value": "higher", "label": "Higher" },
        { "value": "highest", "label": "Highest" }
      ],
      "default": "lowest"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "header_title", "label": "Header title" },
    {
      "type": "textarea",
      "id": "greeting_message",
      "label": "Greeting message"
    },
    { "type": "header", "content": "Featured products" },
    {
      "type": "collection",
      "id": "featured_products_collection",
      "label": "Featured products collection"
    },
    { "type": "header", "content": "Borders" },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 20
    }
  ]
}
{% endschema %}
