// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// This app's tables live in their own "chat_widget" schema rather than
// "public" because this Supabase project also hosts an unrelated app's
// live data in "public" — keeping Prisma scoped to "chat_widget" means
// migrations never touch that schema.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["chat_widget"]
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@schema("chat_widget")
}

model WidgetSettings {
  id                          String    @id @default(cuid())
  shop                        String    @unique
  enabled                     Boolean   @default(true)
  welcomeMessage              String    @default("Hi! How can I help you find what you're looking for?")
  systemPrompt                String    @default("You are a friendly, concise shopping assistant for this store. Use the product lookup tool to answer questions about products, pricing, and availability. Never invent products or prices.")
  primaryColor                String    @default("#1a1a1a")
  iconUrl                     String?
  position                    String    @default("bottom-right")
  headerTitle                 String    @default("Chat with us")
  cornerStyle                 String    @default("rounded")
  geminiModel                 String    @default("gemini-3.5-flash-lite")
  geminiApiKey                String?
  language                    String    @default("auto")
  knowledgeCollections        Json      @default("[]")
  convertedCustomersCount     Int?
  convertedCustomersCheckedAt DateTime?
  updatedAt                   DateTime  @updatedAt

  @@schema("chat_widget")
}

model KnowledgeEntry {
  id                String   @id @default(cuid())
  shop              String
  type              String   @default("freeform")
  question          String?
  answer            String
  productId         String?
  productTitle      String?
  productHandle     String?
  mediaType         String?
  mediaId           String?
  mediaUrl          String?
  mediaName         String?
  mediaStartSeconds Int?
  mediaEndSeconds   Int?
  source            String   @default("manual")
  createdByEmail    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([shop])
  @@schema("chat_widget")
}

model StoreAudit {
  id           String    @id @default(cuid())
  shop         String    @unique
  status       String    @default("pending")
  storeContext String?
  sourceUrls   Json      @default("[]")
  policies     Json      @default("{}")
  lastRunAt    DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@schema("chat_widget")
}

model KnowledgeQuery {
  id             String   @id @default(cuid())
  shop           String
  conversationId String
  question       String
  matched        Boolean  @default(false)
  matchedEntryId String?
  createdAt      DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, matched, createdAt])
  @@schema("chat_widget")
}

model Conversation {
  id                    String    @id @default(cuid())
  shop                  String
  conversationId        String
  customerName          String
  customerEmail         String?
  customerPhone         String?
  needsHuman            Boolean   @default(false)
  needsHumanRequestedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([shop, conversationId])
  @@schema("chat_widget")
}

model ChatMessage {
  id             String   @id @default(cuid())
  shop           String
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  @@index([shop, conversationId, createdAt])
  @@index([shop, createdAt])
  @@schema("chat_widget")
}

// A synced snapshot of the catalog's *shape* — titles, handles, URLs, types,
// options and collection membership. Deliberately does NOT store inventory:
// stock changes constantly, and an assistant that quotes a stale "in stock"
// is exactly what FACTUAL_ACCURACY_GUARDRAILS forbids. Availability is always
// read live through the searchProducts tool; this table exists so the
// assistant knows what the catalog *contains* without having to guess a
// keyword first (e.g. "what do you sell?", "do you have anything under 50?").
model CatalogProduct {
  id               String   @id @default(cuid())
  shop             String
  productId        String
  title            String
  handle           String
  url              String?
  productType      String?
  vendor           String?
  status           String?
  description      String?
  tags             Json     @default("[]")
  options          Json     @default("[]")
  collectionTitles Json     @default("[]")
  minPrice         String?
  maxPrice         String?
  currency         String?
  syncedAt         DateTime @default(now())

  @@unique([shop, productId])
  @@index([shop])
  @@schema("chat_widget")
}

// An index of the store's linkable URLs — content pages, collection pages and
// policy pages. Built from the public sitemap (no extra access scope needed;
// the Admin pages API would require read_content, forcing every merchant to
// re-authorise). Lets the assistant point a shopper at the right page instead
// of describing it from the prose store-context brief.
model StorePage {
  id       String   @id @default(cuid())
  shop     String
  url      String
  title    String?
  type     String   @default("page")
  syncedAt DateTime @default(now())

  @@unique([shop, url])
  @@index([shop])
  @@schema("chat_widget")
}

model CatalogSync {
  id           String    @id @default(cuid())
  shop         String    @unique
  status       String    @default("pending")
  productCount Int       @default(0)
  pageCount    Int       @default(0)
  // The storefront the last sync actually crawled, and how it's built:
  // "online-store" (Liquid theme), "headless" (Hydrogen/Oxygen or a custom
  // framework) or "unknown". Detected empirically — the Admin API exposes no
  // headless flag — see storefront.server.ts.
  storeUrl     String?
  platform     String    @default("unknown")
  lastRunAt    DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@schema("chat_widget")
}

// Health of the AI backend for one shop. Exists because a failing Gemini key
// used to be completely invisible: the model call threw, the stream died, and
// the shopper saw "Sorry, something went wrong" while the merchant saw
// nothing at all — indistinguishable from a bug. See gemini-model.server.ts
// for the production incident that motivated this (shared free-tier key,
// every request 429 "Quota exceeded").
//
// One row per shop, overwritten in place: this is a current-state flag for
// the Plans page, not an audit log.
model AiStatus {
  id              String    @id @default(cuid())
  shop            String    @unique
  // "quota" | "auth" | "billing" | "unknown", or null when healthy.
  lastErrorKind   String?
  lastErrorAt     DateTime?
  lastSuccessAt   DateTime?
  // Whether the failing/succeeding call used the merchant's own Pro-plan key
  // rather than the app's shared one — it decides who has to fix it.
  usedOwnKey      Boolean   @default(false)
  updatedAt       DateTime  @updatedAt

  @@schema("chat_widget")
}

// Links a shop to one Telegram chat so chat activity can be pushed to the
// merchant's phone. This exists because Shopify's own mobile app has no
// notification for widget conversations — Telegram is the push channel.
//
// A shop first gets a `linkCode`, sends it to the shared Orby bot, and the
// webhook fills in `chatId`. Nothing is ever sent until `chatId` is set.
model TelegramLink {
  id        String    @id @default(cuid())
  shop      String    @unique
  linkCode  String    @unique
  chatId    String?
  chatTitle String?
  linkedAt  DateTime?
  enabled   Boolean   @default(true)
  // "all" — every shopper and AI turn; "alerts" — only human-handoff requests.
  feedScope String    @default("all")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@schema("chat_widget")
}

// Maps a message the bot posted back to the conversation it came from, so a
// merchant's native swipe-reply in Telegram can be routed to the right
// conversation without them typing an id.
model TelegramMessageRef {
  id                String   @id @default(cuid())
  shop              String
  chatId            String
  telegramMessageId String
  conversationId    String
  createdAt         DateTime @default(now())

  @@unique([chatId, telegramMessageId])
  @@index([shop, conversationId])
  @@schema("chat_widget")
}
