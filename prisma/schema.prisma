// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// This app's tables live in their own "chat_widget" schema rather than
// "public" because this Supabase project also hosts an unrelated app's
// live data in "public" — keeping Prisma scoped to "chat_widget" means
// migrations never touch that schema.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["chat_widget"]
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@schema("chat_widget")
}

model WidgetSettings {
  id              String   @id @default(cuid())
  shop            String   @unique
  enabled         Boolean  @default(true)
  welcomeMessage  String   @default("Hi! How can I help you find what you're looking for?")
  systemPrompt    String   @default("You are a friendly, concise shopping assistant for this store. Use the product lookup tool to answer questions about products, pricing, and availability. Never invent products or prices.")
  primaryColor    String   @default("#1a1a1a")
  iconUrl         String?
  position        String   @default("bottom-right")
  headerTitle     String   @default("Chat with us")
  cornerStyle     String   @default("rounded")
  geminiModel     String   @default("gemini-2.5-flash")
  geminiApiKey    String?
  language        String   @default("auto")
  knowledgeCollections Json @default("[]")
  updatedAt       DateTime @updatedAt

  @@schema("chat_widget")
}

model KnowledgeEntry {
  id              String   @id @default(cuid())
  shop            String
  type            String   @default("freeform")
  question        String?
  answer          String
  productId       String?
  productTitle    String?
  productHandle   String?
  mediaType       String?
  mediaId         String?
  mediaUrl        String?
  mediaName       String?
  source          String   @default("manual")
  createdByEmail  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shop])
  @@schema("chat_widget")
}

model StoreAudit {
  id           String    @id @default(cuid())
  shop         String    @unique
  status       String    @default("pending")
  storeContext String?
  sourceUrls   Json      @default("[]")
  policies     Json      @default("{}")
  lastRunAt    DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@schema("chat_widget")
}

model KnowledgeQuery {
  id             String   @id @default(cuid())
  shop           String
  conversationId String
  question       String
  matched        Boolean  @default(false)
  matchedEntryId String?
  createdAt      DateTime @default(now())

  @@index([shop, createdAt])
  @@index([shop, matched, createdAt])
  @@schema("chat_widget")
}

model Conversation {
  id                    String    @id @default(cuid())
  shop                  String
  conversationId        String
  customerName          String
  customerEmail         String?
  customerPhone         String?
  needsHuman            Boolean   @default(false)
  needsHumanRequestedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([shop, conversationId])
  @@schema("chat_widget")
}

model ChatMessage {
  id             String   @id @default(cuid())
  shop           String
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  @@index([shop, conversationId, createdAt])
  @@index([shop, createdAt])
  @@schema("chat_widget")
}
