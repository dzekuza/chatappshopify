# Populated automatically by `shopify app dev` / `shopify app deploy`:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=
# SHOPIFY_APP_URL=

# Google Gemini API key used by the AI chat widget (server-side only, never expose to the storefront).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase Postgres connection strings (Project Settings > Database > Connection string).
# DATABASE_URL uses the transaction pooler (port 6543) for app runtime queries.
# Keep `connection_limit=1` on it — serverless functions each open their own pool,
# and the default of 5 exhausts the pooler once both deployments are running.
# DIRECT_URL uses the direct/session connection (port 5432), required for running migrations.
DATABASE_URL=
DIRECT_URL=

# Set to "true" on the dev deployment only. NODE_ENV is "production" on Vercel for
# both deployments, so this is the only way the dev app knows to request *test*
# subscription charges — a dev store can't complete a real one.
SHOPIFY_BILLING_TEST=

# Set to "false" on any deployment whose Shopify app uses *custom* distribution.
# Shopify blocks the Billing API for custom apps ("Custom apps cannot use the
# Billing API"), so the subscription gate has to be skipped there. Leave unset
# on the public production app. https://shopify.dev/docs/apps/launch/distribution
SHOPIFY_BILLING_ENABLED=

# Extra comma-separated myshopify domains that get unlimited conversations
# without a Shopify subscription. Optional — it ADDS to the checked-in list of
# internal stores in billing.server.ts, so leaving it unset changes nothing.
# Use it to comp a store without shipping a deploy.
# e.g. UNLIMITED_CONVERSATION_SHOPS="somestore.myshopify.com"
UNLIMITED_CONVERSATION_SHOPS=

# Telegram push notifications. Shopify's mobile admin app has no notification
# for chat-widget conversations, so Telegram is how a merchant finds out a
# shopper is waiting. One shared bot serves every shop — merchants link their
# own chat with a code from the Settings page, they don't create a bot.
#
# TELEGRAM_BOT_TOKEN — from @BotFather. Leave unset to hide the feature
#   entirely (the Settings card explains it isn't available).
# TELEGRAM_BOT_USERNAME — the bot's @name without the @, used to build the
#   one-tap "Open Telegram" deep link.
# TELEGRAM_WEBHOOK_SECRET — any random string. The webhook route rejects
#   anything that doesn't echo it back, and it's the ONLY thing authenticating
#   that endpoint, so it must match what you pass to setWebhook:
#
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d "url=https://<app-url>/telegram/webhook" \
#     -d "secret_token=<TELEGRAM_WEBHOOK_SECRET>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
