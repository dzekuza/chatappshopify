# Populated automatically by `shopify app dev` / `shopify app deploy`:
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=
# SHOPIFY_APP_URL=

# Google Gemini API key used by the AI chat widget (server-side only, never expose to the storefront).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase Postgres connection strings (Project Settings > Database > Connection string).
# DATABASE_URL uses the transaction pooler (port 6543) for app runtime queries.
# Keep `connection_limit=1` on it — serverless functions each open their own pool,
# and the default of 5 exhausts the pooler once both deployments are running.
# DIRECT_URL uses the direct/session connection (port 5432), required for running migrations.
DATABASE_URL=
DIRECT_URL=

# Set to "true" on the dev deployment only. NODE_ENV is "production" on Vercel for
# both deployments, so this is the only way the dev app knows to request *test*
# subscription charges — a dev store can't complete a real one.
SHOPIFY_BILLING_TEST=
